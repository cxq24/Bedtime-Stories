[
  {
    "id": "u000",
    "paragraph_id": "p000",
    "text": "小朋友们，准备好听故事了吗？今天的故事叫《雨后的干袜子》。",
    "pause_after_s": 0.28
  },
  {
    "id": "u001",
    "paragraph_id": "p000",
    "text": "雨后的袜子湿了一点点，皮皮回家后会怎样照顾自己的小脚呢？",
    "pause_after_s": 0.52
  },
  {
    "id": "u002",
    "paragraph_id": "p001",
    "text": "今天下午放学的时候，森林里刚下过一场阵雨，",
    "pause_after_s": 0.28
  },
  {
    "id": "u003",
    "paragraph_id": "p001",
    "text": "草地和小路上还有些湿漉漉的。皮皮走在回家的路上，",
    "pause_after_s": 0.28
  },
  {
    "id": "u004",
    "paragraph_id": "p001",
    "text": "为了帮小鼹鼠点点捡起被风吹进湿草丛里的画纸，皮皮跨进草丛，",
    "pause_after_s": 0.28
  },
  {
    "id": "u005",
    "paragraph_id": "p001",
    "text": "鞋尖和里面的棉布小袜子，不小心沾上了一点冰凉的雨水。",
    "pause_after_s": 0.52
  },
  {
    "id": "u006",
    "paragraph_id": "p002",
    "text": "现在的皮皮已经知道怎么好好照顾自己的身体了。",
    "pause_after_s": 0.28
  },
  {
    "id": "u007",
    "paragraph_id": "p002",
    "text": "一推开小木屋的门，他没有急着跑去玩玩具，",
    "pause_after_s": 0.28
  },
  {
    "id": "u008",
    "paragraph_id": "p002",
    "text": "而是先坐在玄关的矮木凳上，把两只小脚慢慢放稳，",
    "pause_after_s": 0.28
  },
  {
    "id": "u009",
    "paragraph_id": "p002",
    "text": "脱下了潮湿的鞋袜。",
    "pause_after_s": 0.52
  },
  {
    "id": "u010",
    "paragraph_id": "p003",
    "text": "门边的小竹篮里，早就准备好了妈妈晒得干爽蓬松的备用软袜子，",
    "pause_after_s": 0.28
  },
  {
    "id": "u011",
    "paragraph_id": "p003",
    "text": "一双双叠得平平整整的，正等着他呢。皮皮先把脱下来的那双湿袜子，",
    "pause_after_s": 0.28
  },
  {
    "id": "u012",
    "paragraph_id": "p003",
    "text": "仔细地展开，搭在门廊通风的小木架子上，",
    "pause_after_s": 0.28
  },
  {
    "id": "u013",
    "paragraph_id": "p003",
    "text": "没有把它们乱七八糟地挤成一团；接着，他用温热的毛巾擦干脚丫，",
    "pause_after_s": 0.28
  },
  {
    "id": "u014",
    "paragraph_id": "p003",
    "text": "换上了那双干净的米白色软棉袜。",
    "pause_after_s": 0.52
  },
  {
    "id": "u015",
    "paragraph_id": "p004",
    "text": "哇，干爽的软袜子一裹住脚丫，那种软绵绵、暖融融的感觉，",
    "pause_after_s": 0.28
  },
  {
    "id": "u016",
    "paragraph_id": "p004",
    "text": "一下子就从脚底板传到了心窝里！皮皮踩在屋里的软地垫上，",
    "pause_after_s": 0.28
  },
  {
    "id": "u017",
    "paragraph_id": "p004",
    "text": "轻轻地活动了一下五个小脚趾头，刚才那一点点潮湿和微凉，",
    "pause_after_s": 0.28
  },
  {
    "id": "u018",
    "paragraph_id": "p004",
    "text": "全都消失得无影无踪了。",
    "pause_after_s": 0.52
  },
  {
    "id": "u019",
    "paragraph_id": "p005",
    "text": "吃过晚饭，窗外淅淅沥沥地又落下了几滴小夜雨。不过，",
    "pause_after_s": 0.28
  },
  {
    "id": "u020",
    "paragraph_id": "p005",
    "text": "厚实的小木门已经关好了，屋里的木地板干爽又整洁，",
    "pause_after_s": 0.28
  },
  {
    "id": "u021",
    "paragraph_id": "p005",
    "text": "一点儿也不受外面湿气的影响。",
    "pause_after_s": 0.28
  },
  {
    "id": "u022",
    "paragraph_id": "p005",
    "text": "皮皮把玄关的矮木凳推回墙角的原处，迈着轻柔的步子走到了床边。",
    "pause_after_s": 0.28
  },
  {
    "id": "u023",
    "paragraph_id": "p005",
    "text": "今晚，屋里没有任何一样东西需要湿漉漉地等着了。",
    "pause_after_s": 0.52
  },
  {
    "id": "u024",
    "paragraph_id": "p006",
    "text": "皮皮爬上床，把穿着干爽软袜子的小脚丫伸进被窝里。",
    "pause_after_s": 0.28
  },
  {
    "id": "u025",
    "paragraph_id": "p006",
    "text": "暖黄色的毛毯轻轻落下来，给软袜子外面，",
    "pause_after_s": 0.28
  },
  {
    "id": "u026",
    "paragraph_id": "p006",
    "text": "又添上了一层厚实的温暖与舒服。胡萝卜玩偶乖乖地靠住他的手臂。",
    "pause_after_s": 0.28
  },
  {
    "id": "u027",
    "paragraph_id": "p006",
    "text": "皮皮满足地闭上眼睛，听着外面的雨声慢慢退到很远的地方。",
    "pause_after_s": 0.52
  },
  {
    "id": "u028",
    "paragraph_id": "p007",
    "text": "小朋友，今晚睡觉前，",
    "pause_after_s": 0.28
  },
  {
    "id": "u029",
    "paragraph_id": "p007",
    "text": "你的小手和小脚是不是也洗得干干净净、盖得暖暖和和的呢？",
    "pause_after_s": 0.28
  },
  {
    "id": "u030",
    "paragraph_id": "p007",
    "text": "好好感受这份被照顾的舒服吧，暖暖地躺着，就已经很好了。",
    "pause_after_s": 0.28
  },
  {
    "id": "u031",
    "paragraph_id": "p007",
    "text": "晚安。",
    "pause_after_s": 0.52
  }
]
