[
  {
    "id": "p000_u01",
    "paragraph_id": "p000",
    "text": "小朋友们，准备好听故事了吗？",
    "pause_after_s": 0.55
  },
  {
    "id": "p000_u02",
    "paragraph_id": "p000",
    "text": "今天的故事叫《水壶旁的小云》。",
    "pause_after_s": 0.55
  },
  {
    "id": "p000_u03",
    "paragraph_id": "p000",
    "text": "朋友们来家里做客，忙完之后，",
    "pause_after_s": 0.25
  },
  {
    "id": "p000_u04",
    "paragraph_id": "p000",
    "text": "皮皮怎样让自己也慢慢安顿下来呢？",
    "pause_after_s": 0.55
  },
  {
    "id": "p001_u01",
    "paragraph_id": "p001",
    "text": "皮皮现在越来越能干了。",
    "pause_after_s": 0.55
  },
  {
    "id": "p001_u02",
    "paragraph_id": "p001",
    "text": "今天下午，小熊绒绒和小鹿芽芽来家里一起做手工，",
    "pause_after_s": 0.25
  },
  {
    "id": "p001_u03",
    "paragraph_id": "p001",
    "text": "皮皮像个小主人一样，主动承担起了给大家准备热果茶的任务。",
    "pause_after_s": 0.55
  },
  {
    "id": "p002_u01",
    "paragraph_id": "p002",
    "text": "在傍晚亮起暖灯的小木屋餐厅里，",
    "pause_after_s": 0.25
  },
  {
    "id": "p002_u02",
    "paragraph_id": "p002",
    "text": "圆肚子的搪瓷小水壶坐在隔热垫上，",
    "pause_after_s": 0.25
  },
  {
    "id": "p002_u03",
    "paragraph_id": "p002",
    "text": "壶嘴里正冒出一缕缕淡淡的、",
    "pause_after_s": 0.25
  },
  {
    "id": "p002_u04",
    "paragraph_id": "p002",
    "text": "白色的水汽。",
    "pause_after_s": 0.55
  },
  {
    "id": "p002_u05",
    "paragraph_id": "p002",
    "text": "\n皮皮端着小托盘，给芽芽倒了一杯甜甜的苹果茶，",
    "pause_after_s": 0.25
  },
  {
    "id": "p002_u06",
    "paragraph_id": "p002",
    "text": "又给绒绒倒了一杯香香的蜂蜜水。",
    "pause_after_s": 0.55
  },
  {
    "id": "p002_u07",
    "paragraph_id": "p002",
    "text": "三只彩色的小杯子在桌上排着队，",
    "pause_after_s": 0.25
  },
  {
    "id": "p002_u08",
    "paragraph_id": "p002",
    "text": "大家一边喝茶，一边把做好的松果小人摆满桌面，",
    "pause_after_s": 0.25
  },
  {
    "id": "p002_u09",
    "paragraph_id": "p002",
    "text": "屋子里充满了欢声笑语。",
    "pause_after_s": 0.55
  },
  {
    "id": "p003_u01",
    "paragraph_id": "p003",
    "text": "等好朋友们心满意足地道别回家后，",
    "pause_after_s": 0.25
  },
  {
    "id": "p003_u02",
    "paragraph_id": "p003",
    "text": "皮皮开始收拾小餐桌。",
    "pause_after_s": 0.55
  },
  {
    "id": "p003_u03",
    "paragraph_id": "p003",
    "text": "\n他把喝空的小杯子一只只洗干净，",
    "pause_after_s": 0.25
  },
  {
    "id": "p003_u04",
    "paragraph_id": "p003",
    "text": "放回木托盘里。",
    "pause_after_s": 0.55
  },
  {
    "id": "p003_u05",
    "paragraph_id": "p003",
    "text": "就在他擦干手的时候，他看见桌上的搪瓷小水壶旁边，",
    "pause_after_s": 0.25
  },
  {
    "id": "p003_u06",
    "paragraph_id": "p003",
    "text": "还飘着最后一缕淡淡的白色水汽。",
    "pause_after_s": 0.55
  },
  {
    "id": "p004_u01",
    "paragraph_id": "p004",
    "text": "皮皮没有急着走开，而是隔着桌子，",
    "pause_after_s": 0.25
  },
  {
    "id": "p004_u02",
    "paragraph_id": "p004",
    "text": "双手托着下巴，静静地看那缕水汽慢慢散开。",
    "pause_after_s": 0.55
  },
  {
    "id": "p004_u03",
    "paragraph_id": "p004",
    "text": "\n那团白白的小水汽，刚从壶嘴飘出来的时候，",
    "pause_after_s": 0.25
  },
  {
    "id": "p004_u04",
    "paragraph_id": "p004",
    "text": "弯弯的，像一片轻巧的羽毛叶子；",
    "pause_after_s": 0.25
  },
  {
    "id": "p004_u05",
    "paragraph_id": "p004",
    "text": "往上升了一点后，被屋里的微风一吹，",
    "pause_after_s": 0.25
  },
  {
    "id": "p004_u06",
    "paragraph_id": "p004",
    "text": "又拉得长长的，像一条细细的白色小围巾，",
    "pause_after_s": 0.25
  },
  {
    "id": "p004_u07",
    "paragraph_id": "p004",
    "text": "完全没有固定的样子。",
    "pause_after_s": 0.55
  },
  {
    "id": "p005_u01",
    "paragraph_id": "p005",
    "text": "皮皮没有伸出小爪子去抓它、",
    "pause_after_s": 0.25
  },
  {
    "id": "p005_u02",
    "paragraph_id": "p005",
    "text": "扇它，只是把托盘往旁边挪了挪，",
    "pause_after_s": 0.25
  },
  {
    "id": "p005_u03",
    "paragraph_id": "p005",
    "text": "给桌面腾出一片安静空旷的地方。",
    "pause_after_s": 0.55
  },
  {
    "id": "p005_u04",
    "paragraph_id": "p005",
    "text": "\n水汽越升越高，越来越淡，",
    "pause_after_s": 0.25
  },
  {
    "id": "p005_u05",
    "paragraph_id": "p005",
    "text": "最后无声无息地融进了餐厅暖黄色的灯光里，",
    "pause_after_s": 0.25
  },
  {
    "id": "p005_u06",
    "paragraph_id": "p005",
    "text": "不见了。",
    "pause_after_s": 0.55
  },
  {
    "id": "p005_u07",
    "paragraph_id": "p005",
    "text": "而那只忙碌了一下午的搪瓷小水壶，",
    "pause_after_s": 0.25
  },
  {
    "id": "p005_u08",
    "paragraph_id": "p005",
    "text": "也渐渐凉了下来，安安稳稳地坐在厚厚的软木隔热垫上。",
    "pause_after_s": 0.55
  },
  {
    "id": "p006_u01",
    "paragraph_id": "p006",
    "text": "今天的小杯子们不用再排队盛茶了。",
    "pause_after_s": 0.55
  },
  {
    "id": "p006_u02",
    "paragraph_id": "p006",
    "text": "皮皮拿来干布巾，把桌角留下的一小圈浅浅的水印擦得干干净净，",
    "pause_after_s": 0.25
  },
  {
    "id": "p006_u03",
    "paragraph_id": "p006",
    "text": "然后轻轻关好餐边柜的小木门，",
    "pause_after_s": 0.25
  },
  {
    "id": "p006_u04",
    "paragraph_id": "p006",
    "text": "转身走回了自己的卧室。",
    "pause_after_s": 0.55
  },
  {
    "id": "p006_u05",
    "paragraph_id": "p006",
    "text": "\n他心想：水壶旁的那朵小云，",
    "pause_after_s": 0.25
  },
  {
    "id": "p006_u06",
    "paragraph_id": "p006",
    "text": "已经完成了今晚的旅行；",
    "pause_after_s": 0.25
  },
  {
    "id": "p006_u07",
    "paragraph_id": "p006",
    "text": "而我这个小主人，也完成了今天的招待任务啦。",
    "pause_after_s": 0.55
  },
  {
    "id": "p007_u01",
    "paragraph_id": "p007",
    "text": "卧室里，暖黄色的毛毯已经铺好了，",
    "pause_after_s": 0.25
  },
  {
    "id": "p007_u02",
    "paragraph_id": "p007",
    "text": "小枕头也拍得软软的。",
    "pause_after_s": 0.55
  },
  {
    "id": "p007_u03",
    "paragraph_id": "p007",
    "text": "皮皮把胡萝卜玩偶放近，",
    "pause_after_s": 0.25
  },
  {
    "id": "p007_u04",
    "paragraph_id": "p007",
    "text": "慢悠悠地躺了下来。",
    "pause_after_s": 0.55
  },
  {
    "id": "p007_u05",
    "paragraph_id": "p007",
    "text": "\n端过托盘的小爪子歇着，",
    "pause_after_s": 0.25
  },
  {
    "id": "p007_u06",
    "paragraph_id": "p007",
    "text": "听了一下午笑声的长耳朵也歇着。",
    "pause_after_s": 0.55
  },
  {
    "id": "p007_u07",
    "paragraph_id": "p007",
    "text": "屋里刚才忙活过的地方，",
    "pause_after_s": 0.25
  },
  {
    "id": "p007_u08",
    "paragraph_id": "p007",
    "text": "全都留给了夜晚的安静。",
    "pause_after_s": 0.55
  },
  {
    "id": "p008_u01",
    "paragraph_id": "p008",
    "text": "小朋友，今天一天的忙碌和热闹，",
    "pause_after_s": 0.25
  },
  {
    "id": "p008_u02",
    "paragraph_id": "p008",
    "text": "也可以像那缕小水汽一样，",
    "pause_after_s": 0.25
  },
  {
    "id": "p008_u03",
    "paragraph_id": "p008",
    "text": "轻轻散开啦。",
    "pause_after_s": 0.55
  },
  {
    "id": "p008_u04",
    "paragraph_id": "p008",
    "text": "把身体放得软软的、舒服的，",
    "pause_after_s": 0.25
  },
  {
    "id": "p008_u05",
    "paragraph_id": "p008",
    "text": "晚安，做个轻轻的梦。",
    "pause_after_s": 8.0
  }
]
