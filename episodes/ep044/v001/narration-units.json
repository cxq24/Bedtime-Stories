[
  {
    "id": "p000_u01",
    "paragraph_id": "p000",
    "text": "小朋友们，",
    "pause_after_s": 0.28
  },
  {
    "id": "p000_u02",
    "paragraph_id": "p000",
    "text": "准备好听故事了吗？",
    "pause_after_s": 0.95
  },
  {
    "id": "p000_u03",
    "paragraph_id": "p000",
    "text": "今天的故事叫《冰窗花的小花园》。",
    "pause_after_s": 0.95
  },
  {
    "id": "p000_u04",
    "paragraph_id": "p000",
    "text": "窗玻璃上开出了一座冰做的小花园，",
    "pause_after_s": 0.28
  },
  {
    "id": "p000_u05",
    "paragraph_id": "p000",
    "text": "里面藏着怎样的图案呢？",
    "pause_after_s": 0.95
  },
  {
    "id": "p001_u01",
    "paragraph_id": "p001",
    "text": "冬天的清晨特别冷，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u02",
    "paragraph_id": "p001",
    "text": "皮皮早起准备去森林学堂的时候，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u03",
    "paragraph_id": "p001",
    "text": "惊喜地发现卧室玻璃窗的四个角落上，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u04",
    "paragraph_id": "p001",
    "text": "结出了一小片晶莹剔透的冰窗花！",
    "pause_after_s": 0.95
  },
  {
    "id": "p001_u05",
    "paragraph_id": "p001",
    "text": "\n那些细细密密的冰晶纹路，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u06",
    "paragraph_id": "p001",
    "text": "在晨光里闪着银光，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u07",
    "paragraph_id": "p001",
    "text": "就像冬天爷爷在夜里偷偷画上去的一座白色袖珍小花园。",
    "pause_after_s": 0.95
  },
  {
    "id": "p002_u01",
    "paragraph_id": "p002",
    "text": "下午放学回到家，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u02",
    "paragraph_id": "p002",
    "text": "太阳还没落山，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u03",
    "paragraph_id": "p002",
    "text": "皮皮趁着窗角的冰窗花还没完全消融，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u04",
    "paragraph_id": "p002",
    "text": "赶紧搬来小桌子坐在窗前，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u05",
    "paragraph_id": "p002",
    "text": "仔细地欣赏起来。",
    "pause_after_s": 0.95
  },
  {
    "id": "p002_u06",
    "paragraph_id": "p002",
    "text": "\n他顺着冰花的纹路慢慢看过去：",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u07",
    "paragraph_id": "p002",
    "text": "有的冰晶分着叉，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u08",
    "paragraph_id": "p002",
    "text": "像一棵长满冰挂的松树；",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u09",
    "paragraph_id": "p002",
    "text": "有的弯弯曲曲，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u10",
    "paragraph_id": "p002",
    "text": "像一丛迎风摇摆的细草；",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u11",
    "paragraph_id": "p002",
    "text": "在松树和细草中间，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u12",
    "paragraph_id": "p002",
    "text": "还有一条亮晶晶的、弯弯的小路。",
    "pause_after_s": 0.95
  },
  {
    "id": "p003_u01",
    "paragraph_id": "p003",
    "text": "皮皮没有用热乎乎的小爪子去擦玻璃，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u02",
    "paragraph_id": "p003",
    "text": "因为他知道一碰冰花就会化掉。",
    "pause_after_s": 0.95
  },
  {
    "id": "p003_u03",
    "paragraph_id": "p003",
    "text": "他拿来一张白色画纸和银灰色的彩铅，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u04",
    "paragraph_id": "p003",
    "text": "放在桌上，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u05",
    "paragraph_id": "p003",
    "text": "安安静静地画下了冰窗花里自己最喜欢的一小段风景。",
    "pause_after_s": 0.95
  },
  {
    "id": "p003_u06",
    "paragraph_id": "p003",
    "text": "\n画纸上的那条小路画得不怎么笔直，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u07",
    "paragraph_id": "p003",
    "text": "不过它轻巧地绕过了几片草叶，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u08",
    "paragraph_id": "p003",
    "text": "刚好走到了一朵圆圆的冰花旁边。",
    "pause_after_s": 0.95
  },
  {
    "id": "p004_u01",
    "paragraph_id": "p004",
    "text": "到了晚上，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u02",
    "paragraph_id": "p004",
    "text": "屋里的暖炉烧得旺旺的，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u03",
    "paragraph_id": "p004",
    "text": "室内外温差变了，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u04",
    "paragraph_id": "p004",
    "text": "等皮皮洗完澡再去看窗户时，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u05",
    "paragraph_id": "p004",
    "text": "窗角那片冰窗花的纹路，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u06",
    "paragraph_id": "p004",
    "text": "已经悄悄地融化、变了模样，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u07",
    "paragraph_id": "p004",
    "text": "不再是下午那座小花园了。",
    "pause_after_s": 0.95
  },
  {
    "id": "p004_u08",
    "paragraph_id": "p004",
    "text": "\n如果是以前，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u09",
    "paragraph_id": "p004",
    "text": "皮皮可能会觉得惋惜，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u10",
    "paragraph_id": "p004",
    "text": "想拿着画笔再去窗边追着画下冰花新变成的样子。",
    "pause_after_s": 0.95
  },
  {
    "id": "p005_u01",
    "paragraph_id": "p005",
    "text": "但皮皮看了看桌上的画纸，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u02",
    "paragraph_id": "p005",
    "text": "下午那座漂亮的小花园，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u03",
    "paragraph_id": "p005",
    "text": "已经安安静静地留在他的画纸上了。",
    "pause_after_s": 0.95
  },
  {
    "id": "p005_u04",
    "paragraph_id": "p005",
    "text": "大自然里的冰窗花有它自己的变化，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u05",
    "paragraph_id": "p005",
    "text": "融化了，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u06",
    "paragraph_id": "p005",
    "text": "明天夜里冷的时候还会再结出新的图案，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u07",
    "paragraph_id": "p005",
    "text": "不需要一整晚都守在窗边拿着画笔去追赶它。",
    "pause_after_s": 0.95
  },
  {
    "id": "p005_u08",
    "paragraph_id": "p005",
    "text": "\n皮皮把画纸小心地夹进自己的绘本里，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u09",
    "paragraph_id": "p005",
    "text": "收好了彩铅。",
    "pause_after_s": 0.95
  },
  {
    "id": "p006_u01",
    "paragraph_id": "p006",
    "text": "床上的暖黄毛毯暖暖的，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u02",
    "paragraph_id": "p006",
    "text": "大枕头软软的。",
    "pause_after_s": 0.95
  },
  {
    "id": "p006_u03",
    "paragraph_id": "p006",
    "text": "皮皮爬上床，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u04",
    "paragraph_id": "p006",
    "text": "让两只长耳朵慢慢地落在枕头边。",
    "pause_after_s": 0.95
  },
  {
    "id": "p006_u05",
    "paragraph_id": "p006",
    "text": "\n他闭上眼睛。",
    "pause_after_s": 0.95
  },
  {
    "id": "p006_u06",
    "paragraph_id": "p006",
    "text": "窗外玻璃上的冰花小花园，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u07",
    "paragraph_id": "p006",
    "text": "可以在夜里继续自由地生长或融化，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u08",
    "paragraph_id": "p006",
    "text": "今晚的小兔子，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u09",
    "paragraph_id": "p006",
    "text": "不用一直睁着眼睛看着它了。",
    "pause_after_s": 0.95
  },
  {
    "id": "p007_u01",
    "paragraph_id": "p007",
    "text": "小朋友，",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u02",
    "paragraph_id": "p007",
    "text": "把今天看过的漂亮景色轻轻收进记忆里吧。",
    "pause_after_s": 0.95
  },
  {
    "id": "p007_u03",
    "paragraph_id": "p007",
    "text": "外面的世界会自己慢慢变化，",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u04",
    "paragraph_id": "p007",
    "text": "现在，",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u05",
    "paragraph_id": "p007",
    "text": "给自己一段温暖又安静的睡眠时光。",
    "pause_after_s": 0.95
  },
  {
    "id": "p007_u06",
    "paragraph_id": "p007",
    "text": "晚安。",
    "pause_after_s": 8.95
  }
]
