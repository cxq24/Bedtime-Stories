[
  {
    "id": "p000_u01",
    "paragraph_id": "p000",
    "text": "小朋友们，",
    "pause_after_s": 0.28
  },
  {
    "id": "p000_u02",
    "paragraph_id": "p000",
    "text": "准备好听故事了吗？",
    "pause_after_s": 0.95
  },
  {
    "id": "p000_u03",
    "paragraph_id": "p000",
    "text": "今天的故事叫《小熊借来的绒毯》。",
    "pause_after_s": 0.95
  },
  {
    "id": "p000_u04",
    "paragraph_id": "p000",
    "text": "一条绒毯分给朋友以后，",
    "pause_after_s": 0.28
  },
  {
    "id": "p000_u05",
    "paragraph_id": "p000",
    "text": "怎样让两个人都留有足够的温暖呢？",
    "pause_after_s": 0.95
  },
  {
    "id": "p001_u01",
    "paragraph_id": "p001",
    "text": "昨天下午，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u02",
    "paragraph_id": "p001",
    "text": "森林里飘着零星的小雪花，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u03",
    "paragraph_id": "p001",
    "text": "小熊绒绒来皮皮家做客。",
    "pause_after_s": 0.95
  },
  {
    "id": "p001_u04",
    "paragraph_id": "p001",
    "text": "为了能坐在门廊下一边看雪景、一边听故事，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u05",
    "paragraph_id": "p001",
    "text": "皮皮从屋里拿出了一条厚厚的米白色法兰绒毯，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u06",
    "paragraph_id": "p001",
    "text": "铺在宽宽的木头长椅上，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u07",
    "paragraph_id": "p001",
    "text": "和绒绒一人盖一半。",
    "pause_after_s": 0.95
  },
  {
    "id": "p002_u01",
    "paragraph_id": "p002",
    "text": "后来天黑的时候雪下大了，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u02",
    "paragraph_id": "p002",
    "text": "皮皮担心绒绒回家的路上冷，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u03",
    "paragraph_id": "p002",
    "text": "就把这条米白色的绒毯借给了绒绒，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u04",
    "paragraph_id": "p002",
    "text": "让他披在身上挡风雪。",
    "pause_after_s": 0.95
  },
  {
    "id": "p002_u05",
    "paragraph_id": "p002",
    "text": "今天傍晚，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u06",
    "paragraph_id": "p002",
    "text": "天放晴了，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u07",
    "paragraph_id": "p002",
    "text": "小熊绒绒准时来到了皮皮家门前。",
    "pause_after_s": 0.95
  },
  {
    "id": "p002_u08",
    "paragraph_id": "p002",
    "text": "他双手捧着那条米白绒毯，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u09",
    "paragraph_id": "p002",
    "text": "已经由熊妈妈帮着洗净烘干，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u10",
    "paragraph_id": "p002",
    "text": "四个边角叠得方方正正的；",
    "pause_after_s": 0.95
  },
  {
    "id": "p002_u11",
    "paragraph_id": "p002",
    "text": "更有趣的是，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u12",
    "paragraph_id": "p002",
    "text": "绒绒还在绒毯最上面，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u13",
    "paragraph_id": "p002",
    "text": "放了一片干净的绿色冬青叶当作感谢的小礼物。",
    "pause_after_s": 0.95
  },
  {
    "id": "p003_u01",
    "paragraph_id": "p003",
    "text": "皮皮开心地接过绒毯，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u02",
    "paragraph_id": "p003",
    "text": "先拿下那片绿油油的冬青叶放进小碟子里，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u03",
    "paragraph_id": "p003",
    "text": "然后双手把叠好的毯子展开，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u04",
    "paragraph_id": "p003",
    "text": "轻轻抖了抖。",
    "pause_after_s": 0.95
  },
  {
    "id": "p003_u05",
    "paragraph_id": "p003",
    "text": "经过阳光和烘干的绒毯，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u06",
    "paragraph_id": "p003",
    "text": "一下子变得蓬松极了，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u07",
    "paragraph_id": "p003",
    "text": "散发着一股好闻的皂角清香。",
    "pause_after_s": 0.95
  },
  {
    "id": "p004_u01",
    "paragraph_id": "p004",
    "text": "小熊绒绒伸出厚厚的大爪子，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u02",
    "paragraph_id": "p004",
    "text": "摸了摸毯子的一角，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u03",
    "paragraph_id": "p004",
    "text": "憨厚地笑着说：",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u04",
    "paragraph_id": "p004",
    "text": "“皮皮，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u05",
    "paragraph_id": "p004",
    "text": "你的毯子真暖和，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u06",
    "paragraph_id": "p004",
    "text": "摸起来软软的，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u07",
    "paragraph_id": "p004",
    "text": "和昨天我们并排坐着看雪的时候一样舒服。”",
    "pause_after_s": 0.95
  },
  {
    "id": "p004_u08",
    "paragraph_id": "p004",
    "text": "皮皮把绒毯重新平平整整地折好，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u09",
    "paragraph_id": "p004",
    "text": "放进卧室床尾的藤编篮子里，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u10",
    "paragraph_id": "p004",
    "text": "对绒绒说：",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u11",
    "paragraph_id": "p004",
    "text": "“我就把它放在这个篮子里，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u12",
    "paragraph_id": "p004",
    "text": "等下回再下雪的时候，",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u13",
    "paragraph_id": "p004",
    "text": "我们还可以一起拿出来盖着看雪！”",
    "pause_after_s": 0.95
  },
  {
    "id": "p005_u01",
    "paragraph_id": "p005",
    "text": "送走绒绒后，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u02",
    "paragraph_id": "p005",
    "text": "小木屋安静了下来。",
    "pause_after_s": 0.95
  },
  {
    "id": "p005_u03",
    "paragraph_id": "p005",
    "text": "绒绒回自己家里，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u04",
    "paragraph_id": "p005",
    "text": "去盖他那床厚实的大熊棉被了；",
    "pause_after_s": 0.95
  },
  {
    "id": "p005_u05",
    "paragraph_id": "p005",
    "text": "而皮皮也回到了自己的床边。",
    "pause_after_s": 0.95
  },
  {
    "id": "p005_u06",
    "paragraph_id": "p005",
    "text": "今晚，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u07",
    "paragraph_id": "p005",
    "text": "两位好朋友都在各自的家里，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u08",
    "paragraph_id": "p005",
    "text": "拥有着满满当当的温暖。",
    "pause_after_s": 0.95
  },
  {
    "id": "p005_u09",
    "paragraph_id": "p005",
    "text": "皮皮爬上床，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u10",
    "paragraph_id": "p005",
    "text": "拉好自己平时盖的暖黄色毛毯，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u11",
    "paragraph_id": "p005",
    "text": "把胡萝卜玩偶抱近胸口。",
    "pause_after_s": 0.95
  },
  {
    "id": "p006_u01",
    "paragraph_id": "p006",
    "text": "他没有再把那条米白绒毯拿出来重新铺在门廊上，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u02",
    "paragraph_id": "p006",
    "text": "把昨天的雪景再演一遍；",
    "pause_after_s": 0.95
  },
  {
    "id": "p006_u03",
    "paragraph_id": "p006",
    "text": "因为昨天和好朋友肩并着肩坐在一起看雪的那一小段安静又温暖的时光，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u04",
    "paragraph_id": "p006",
    "text": "已经像那片冬青叶一样，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u05",
    "paragraph_id": "p006",
    "text": "稳稳地留在他的心里了。",
    "pause_after_s": 0.95
  },
  {
    "id": "p006_u06",
    "paragraph_id": "p006",
    "text": "皮皮闭上眼睛，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u07",
    "paragraph_id": "p006",
    "text": "呼吸均匀而绵长。",
    "pause_after_s": 0.95
  },
  {
    "id": "p007_u01",
    "paragraph_id": "p007",
    "text": "小朋友，",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u02",
    "paragraph_id": "p007",
    "text": "和好朋友分享过的快乐时光，",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u03",
    "paragraph_id": "p007",
    "text": "会一直留在记忆里温暖着我们。",
    "pause_after_s": 0.95
  },
  {
    "id": "p007_u04",
    "paragraph_id": "p007",
    "text": "现在，",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u05",
    "paragraph_id": "p007",
    "text": "回到属于你自己的温暖被窝里，",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u06",
    "paragraph_id": "p007",
    "text": "安心睡个好觉吧。",
    "pause_after_s": 0.95
  },
  {
    "id": "p007_u07",
    "paragraph_id": "p007",
    "text": "晚安。",
    "pause_after_s": 0.95
  }
]
