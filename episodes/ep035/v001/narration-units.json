[
  {
    "id": "p000_u01",
    "paragraph_id": "p000",
    "text": "小朋友们，准备好听故事了吗？",
    "pause_after_s": 0.28
  },
  {
    "id": "p000_u02",
    "paragraph_id": "p000",
    "text": "今天的故事叫《栗子的小布袋》。",
    "pause_after_s": 0.28
  },
  {
    "id": "p000_u03",
    "paragraph_id": "p000",
    "text": "秋游捡来的板栗，皮皮会怎样把它们轻轻收好呢？",
    "pause_after_s": 0.9
  },
  {
    "id": "p001_u01",
    "paragraph_id": "p001",
    "text": "今天森林学堂组织大家去后山的板栗林里秋游。",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u02",
    "paragraph_id": "p001",
    "text": "\n板栗树下掉满了裂开嘴的刺球壳，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u03",
    "paragraph_id": "p001",
    "text": "小刺猬栗栗和小熊绒绒用小木夹拨开刺球，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u04",
    "paragraph_id": "p001",
    "text": "皮皮则负责把里面滚出来的油亮亮的褐红色板栗，",
    "pause_after_s": 0.28
  },
  {
    "id": "p001_u05",
    "paragraph_id": "p001",
    "text": "一颗一颗捡进篮子里。",
    "pause_after_s": 0.9
  },
  {
    "id": "p002_u01",
    "paragraph_id": "p002",
    "text": "分果子的时候，皮皮分到了满满两捧圆滚滚的大栗子。",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u02",
    "paragraph_id": "p002",
    "text": "\n一路上，皮皮都舍不得把栗子放进书包里，",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u03",
    "paragraph_id": "p002",
    "text": "而是用两只小爪子捧在胸前。",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u04",
    "paragraph_id": "p002",
    "text": "栗子壳滑溜溜、沉甸甸的，带着太阳晒过的果木香气，皮皮走一路、",
    "pause_after_s": 0.28
  },
  {
    "id": "p002_u05",
    "paragraph_id": "p002",
    "text": "看一路，喜欢得不得了。",
    "pause_after_s": 0.9
  },
  {
    "id": "p003_u01",
    "paragraph_id": "p003",
    "text": "回到小木屋，吃过晚饭，皮皮把白天捡来的栗子全都倒在了卧室的小",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u02",
    "paragraph_id": "p003",
    "text": "矮桌上，想在睡觉前再一颗颗数一数、摸一摸。",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u03",
    "paragraph_id": "p003",
    "text": "\n栗子太多太圆了，皮皮刚数到第五颗，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u04",
    "paragraph_id": "p003",
    "text": "最边上的一枚胖栗子就顺着桌面轻轻滑动起来，",
    "pause_after_s": 0.28
  },
  {
    "id": "p003_u05",
    "paragraph_id": "p003",
    "text": "“骨碌碌”往桌沿滚去。",
    "pause_after_s": 0.9
  },
  {
    "id": "p004_u01",
    "paragraph_id": "p004",
    "text": "皮皮眼疾手快，伸出小爪子在桌边稳稳地接住了它。",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u02",
    "paragraph_id": "p004",
    "text": "\n他看了看满桌滚动的栗子，又摸了摸自己因为捧了一路而有些发酸",
    "pause_after_s": 0.28
  },
  {
    "id": "p004_u03",
    "paragraph_id": "p004",
    "text": "的手腕，心想：再好看的宝贝，也不能一整晚都捧在爪心里睡觉呀。",
    "pause_after_s": 0.9
  },
  {
    "id": "p005_u01",
    "paragraph_id": "p005",
    "text": "于是，皮皮从抽屉里找来了一只妈妈缝的粗棉小布袋。",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u02",
    "paragraph_id": "p005",
    "text": "\n他用一只爪子把布袋口大大地撑开，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u03",
    "paragraph_id": "p005",
    "text": "另一只爪子把桌上的栗子一枚一枚地请进去。",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u04",
    "paragraph_id": "p005",
    "text": "栗子落进柔软厚实的布袋底，发出“噗、噗”的轻响，",
    "pause_after_s": 0.28
  },
  {
    "id": "p005_u05",
    "paragraph_id": "p005",
    "text": "再也不会到处乱滚了。",
    "pause_after_s": 0.9
  },
  {
    "id": "p006_u01",
    "paragraph_id": "p006",
    "text": "当最后一枚胖栗子也放进去后，小布袋鼓起了一个圆滚滚的小肚子，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u02",
    "paragraph_id": "p006",
    "text": "看起来就像一只吃饱了饭、正安静坐着打盹的小动物。",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u03",
    "paragraph_id": "p006",
    "text": "\n皮皮把袋口的抽绳轻轻收拢，打了个松松的结，",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u04",
    "paragraph_id": "p006",
    "text": "然后把小布袋放进了床边的矮柜里。",
    "pause_after_s": 0.28
  },
  {
    "id": "p006_u05",
    "paragraph_id": "p006",
    "text": "白天的满满收获，终于可以不用一直抓在手上了。",
    "pause_after_s": 0.9
  },
  {
    "id": "p007_u01",
    "paragraph_id": "p007",
    "text": "小矮桌的桌面重新空出了一大片位置。",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u02",
    "paragraph_id": "p007",
    "text": "床头灯的暖光落下来，连桌面上那小块干干净净的空白，",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u03",
    "paragraph_id": "p007",
    "text": "看起来都显得格外舒服。",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u04",
    "paragraph_id": "p007",
    "text": "\n皮皮坐到床边，彻底松开忙碌了一天的小爪子，",
    "pause_after_s": 0.28
  },
  {
    "id": "p007_u05",
    "paragraph_id": "p007",
    "text": "再把软绵绵的胡萝卜玩偶轻轻抱进怀里。",
    "pause_after_s": 0.9
  },
  {
    "id": "p008_u01",
    "paragraph_id": "p008",
    "text": "暖黄色的毛毯盖好后，皮皮慢慢闭上了眼睛。",
    "pause_after_s": 0.28
  },
  {
    "id": "p008_u02",
    "paragraph_id": "p008",
    "text": "圆滚滚的栗子有了自己的棉布小袋子，",
    "pause_after_s": 0.28
  },
  {
    "id": "p008_u03",
    "paragraph_id": "p008",
    "text": "而皮皮也有了自己温暖的小被窝。",
    "pause_after_s": 0.28
  },
  {
    "id": "p008_u04",
    "paragraph_id": "p008",
    "text": "\n小朋友，今天你学到的新本领、得到的好东西，",
    "pause_after_s": 0.28
  },
  {
    "id": "p008_u05",
    "paragraph_id": "p008",
    "text": "都已经好好地收起来啦。",
    "pause_after_s": 0.28
  },
  {
    "id": "p008_u06",
    "paragraph_id": "p008",
    "text": "现在，松开小手，让双手也舒舒服服地歇一歇吧。",
    "pause_after_s": 0.28
  },
  {
    "id": "p008_u07",
    "paragraph_id": "p008",
    "text": "晚安。",
    "pause_after_s": 0.4
  }
]
