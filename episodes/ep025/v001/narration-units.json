[
  {
    "id": "u000",
    "paragraph_id": "p000",
    "text": "小朋友们，准备好听故事了吗？",
    "pause_after_s": 0.55
  },
  {
    "id": "u001",
    "paragraph_id": "p000",
    "text": "今天的故事叫《小溪把声音放轻》。",
    "pause_after_s": 0.55
  },
  {
    "id": "u002",
    "paragraph_id": "p000",
    "text": "热闹的小溪边，到了休息的时候，水声会怎样变轻呢？",
    "pause_after_s": 0.55
  },
  {
    "id": "u003",
    "paragraph_id": "p001",
    "text": "今天对于皮皮来说，是个特别难忘的日子——森林学堂的全体小朋友，",
    "pause_after_s": 0.3
  },
  {
    "id": "u004",
    "paragraph_id": "p001",
    "text": "跟着山羊老师去了森林深处的“哗啦啦小溪”，进行了一次开心的小小日间野营。",
    "pause_after_s": 0.55
  },
  {
    "id": "u005",
    "paragraph_id": "p002",
    "text": "白天的溪水可热闹啦！",
    "pause_after_s": 0.55
  },
  {
    "id": "u006",
    "paragraph_id": "p002",
    "text": "清澈的溪水从圆滚滚的鹅卵石旁边跑过去，发出“哗啦啦、叮咚咚”的欢快响声，摸起来凉丝丝的。",
    "pause_after_s": 0.55
  },
  {
    "id": "u007",
    "paragraph_id": "p002",
    "text": "下午自由活动的时候，小松鼠团团和小熊绒绒在浅水滩边比赛打水漂，欢呼声一阵高过一阵。",
    "pause_after_s": 0.55
  },
  {
    "id": "u008",
    "paragraph_id": "p003",
    "text": "皮皮玩了一会儿水后，觉得有点累了，",
    "pause_after_s": 0.3
  },
  {
    "id": "u009",
    "paragraph_id": "p003",
    "text": "就独自坐在岸边一块晒得暖洋洋的大石头上，把小爪子放在膝头，",
    "pause_after_s": 0.3
  },
  {
    "id": "u010",
    "paragraph_id": "p003",
    "text": "安静地看着水面。",
    "pause_after_s": 0.55
  },
  {
    "id": "u011",
    "paragraph_id": "p003",
    "text": "这时，一片细长的柳叶掉进了溪水里。",
    "pause_after_s": 0.55
  },
  {
    "id": "u012",
    "paragraph_id": "p003",
    "text": "它顺着水流，在“哗啦啦”的浪花间慢慢地漂了过去。",
    "pause_after_s": 0.55
  },
  {
    "id": "u013",
    "paragraph_id": "p004",
    "text": "皮皮用目光护送着那片小柳叶。",
    "pause_after_s": 0.55
  },
  {
    "id": "u014",
    "paragraph_id": "p004",
    "text": "只见柳叶漂到一块大圆石头的后面时，",
    "pause_after_s": 0.3
  },
  {
    "id": "u015",
    "paragraph_id": "p004",
    "text": "水流忽然变缓了；小柳叶在平静的水面上打了一个优雅的小转身，",
    "pause_after_s": 0.3
  },
  {
    "id": "u016",
    "paragraph_id": "p004",
    "text": "便轻轻地停靠在了平缓的岸边水草旁，不再往前跑了。",
    "pause_after_s": 0.55
  },
  {
    "id": "u017",
    "paragraph_id": "p004",
    "text": "集合的哨声响起时，皮皮没有再去追着看小柳叶，他轻轻站起身，",
    "pause_after_s": 0.3
  },
  {
    "id": "u018",
    "paragraph_id": "p004",
    "text": "拍掉裤子上的草屑，牵着好朋友的手，沿着熟悉的森林小路回了家。",
    "pause_after_s": 0.55
  },
  {
    "id": "u019",
    "paragraph_id": "p005",
    "text": "到了晚上，洗去了一身的疲惫，皮皮躺进了自己卧室的小木床里。",
    "pause_after_s": 0.55
  },
  {
    "id": "u020",
    "paragraph_id": "p005",
    "text": "现在，",
    "pause_after_s": 0.3
  },
  {
    "id": "u021",
    "paragraph_id": "p005",
    "text": "那条热闹的“哗啦啦小溪”已经留在了窗外很远很远的森林深处；而柔软的小床就在身边，",
    "pause_after_s": 0.3
  },
  {
    "id": "u022",
    "paragraph_id": "p005",
    "text": "暖黄色的毛毯正暖暖地铺在身上。",
    "pause_after_s": 0.55
  },
  {
    "id": "u023",
    "paragraph_id": "p006",
    "text": "皮皮把胡萝卜玩偶抱近了一点，闭着眼睛在脑海里想象：此时此刻，",
    "pause_after_s": 0.3
  },
  {
    "id": "u024",
    "paragraph_id": "p006",
    "text": "白天那片停在石头后面的小柳叶，一定也在安静的水湾里睡着了吧？",
    "pause_after_s": 0.55
  },
  {
    "id": "u025",
    "paragraph_id": "p006",
    "text": "他竖起长耳朵仔细听了听，屋里没有白天哗啦啦的水声，",
    "pause_after_s": 0.3
  },
  {
    "id": "u026",
    "paragraph_id": "p006",
    "text": "也没有伙伴们的欢呼声，只有自己一吸、一呼，轻轻的、均匀的呼吸声。",
    "pause_after_s": 0.55
  },
  {
    "id": "u027",
    "paragraph_id": "p007",
    "text": "就像溪水流到大石头后面会自动把声音放轻一样，",
    "pause_after_s": 0.3
  },
  {
    "id": "u028",
    "paragraph_id": "p007",
    "text": "皮皮白天那些热闹的记忆和兴奋的心情，也慢慢地淡了下来、缓了下来。",
    "pause_after_s": 0.55
  },
  {
    "id": "u029",
    "paragraph_id": "p007",
    "text": "皮皮的眼皮，也像那片靠岸的小柳叶一样，轻轻地合拢、停住了。",
    "pause_after_s": 0.55
  },
  {
    "id": "u030",
    "paragraph_id": "p008",
    "text": "小朋友，今天看过的热闹风景、玩过的开心游戏，都已经稳稳地留在心里啦。",
    "pause_after_s": 0.55
  },
  {
    "id": "u031",
    "paragraph_id": "p008",
    "text": "现在，小溪把声音放轻了，你也安心地待在温暖的小床上，慢慢睡去吧。",
    "pause_after_s": 0.55
  },
  {
    "id": "u032",
    "paragraph_id": "p008",
    "text": "晚安。",
    "pause_after_s": 0.55
  }
]
