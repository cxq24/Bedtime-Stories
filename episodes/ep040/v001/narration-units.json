[
  {
    "id": "p000_u01",
    "paragraph_id": "p000",
    "text": "小朋友们，准备好听故事了吗？",
    "pause_after_s": 0.72
  },
  {
    "id": "p000_u02",
    "paragraph_id": "p000",
    "text": "今天的故事叫《秋天的声音盒》。",
    "pause_after_s": 0.72
  },
  {
    "id": "p000_u03",
    "paragraph_id": "p000",
    "text": "团团和芽芽最喜欢秋天的不同声音，他们会把这些声音收藏在哪里呢？",
    "pause_after_s": 0.72
  },
  {
    "id": "p001_u01",
    "paragraph_id": "p001",
    "text": "秋天快要过去的时候，山羊老师在森林学堂里问大家：",
    "pause_after_s": 0.72
  },
  {
    "id": "p001_u02",
    "paragraph_id": "p001",
    "text": "“你们最喜欢秋天的什么声音呀？”",
    "pause_after_s": 0.72
  },
  {
    "id": "p001_u03",
    "paragraph_id": "p001",
    "text": "小松鼠团团说喜欢啃坚果的“咔嚓”声，",
    "pause_after_s": 0.72
  },
  {
    "id": "p001_u04",
    "paragraph_id": "p001",
    "text": "小鹿芽芽说喜欢秋风吹过芦苇的“呼呼”声。",
    "pause_after_s": 0.72
  },
  {
    "id": "p002_u01",
    "paragraph_id": "p002",
    "text": "皮皮听着大家的回答，觉得秋天的每一种声音都好听极了。",
    "pause_after_s": 0.72
  },
  {
    "id": "p002_u02",
    "paragraph_id": "p002",
    "text": "傍晚放学回到家，皮皮从柜子里翻出了一只空空的、带盖子的小松木盒。",
    "pause_after_s": 0.72
  },
  {
    "id": "p002_u03",
    "paragraph_id": "p002",
    "text": "他突发奇想，想把今天在森林里听过的所有好听的秋天声音，",
    "pause_after_s": 0.72
  },
  {
    "id": "p002_u04",
    "paragraph_id": "p002",
    "text": "全都装进这只小木盒里收藏起来。",
    "pause_after_s": 0.72
  },
  {
    "id": "p003_u01",
    "paragraph_id": "p003",
    "text": "他捧着打开的小木盒走到门廊下，心里默念着：",
    "pause_after_s": 0.72
  },
  {
    "id": "p003_u02",
    "paragraph_id": "p003",
    "text": "我要装进脚踩落叶的“沙沙”声，",
    "pause_after_s": 0.72
  },
  {
    "id": "p003_u03",
    "paragraph_id": "p003",
    "text": "装进熟透的松果掉在泥土上的“噗通”声，",
    "pause_after_s": 0.72
  },
  {
    "id": "p003_u04",
    "paragraph_id": "p003",
    "text": "还要装进好朋友小熊绒绒走到门前时、慢慢停住的温柔脚步声。",
    "pause_after_s": 0.72
  },
  {
    "id": "p003_u05",
    "paragraph_id": "p003",
    "text": "装了一会儿，皮皮赶紧把木盒盖子合上，",
    "pause_after_s": 0.72
  },
  {
    "id": "p003_u06",
    "paragraph_id": "p003",
    "text": "抱回安静的卧室里。",
    "pause_after_s": 0.72
  },
  {
    "id": "p004_u01",
    "paragraph_id": "p004",
    "text": "他满怀期待地把小耳朵贴在木盒盖子上，",
    "pause_after_s": 0.72
  },
  {
    "id": "p004_u02",
    "paragraph_id": "p004",
    "text": "打开一条小缝仔细地听——咦？",
    "pause_after_s": 0.72
  },
  {
    "id": "p004_u03",
    "paragraph_id": "p004",
    "text": "木盒里空空荡荡的，什么声音也没有传出来。",
    "pause_after_s": 0.72
  },
  {
    "id": "p004_u04",
    "paragraph_id": "p004",
    "text": "皮皮贴近了再听一听，只能听见卧室里安安静静的夜色，和自己轻轻的呼吸声。",
    "pause_after_s": 0.72
  },
  {
    "id": "p004_u05",
    "paragraph_id": "p004",
    "text": "原来，声音是没法像栗子一样被抓进盒子里的。",
    "pause_after_s": 0.72
  },
  {
    "id": "p005_u01",
    "paragraph_id": "p005",
    "text": "皮皮摸着下巴想了想，一点儿也没有觉得失望。",
    "pause_after_s": 0.72
  },
  {
    "id": "p005_u02",
    "paragraph_id": "p005",
    "text": "他走到桌边，拿来一片今天和绒绒一起散步时捡到的红叶，",
    "pause_after_s": 0.72
  },
  {
    "id": "p005_u03",
    "paragraph_id": "p005",
    "text": "轻轻地平放在了小木盒的底部。",
    "pause_after_s": 0.72
  },
  {
    "id": "p005_u04",
    "paragraph_id": "p005",
    "text": "当他看着这片红叶时，耳边好像自然而然就响起了白天踩在落叶上的“沙沙”声，",
    "pause_after_s": 0.72
  },
  {
    "id": "p005_u05",
    "paragraph_id": "p005",
    "text": "还有朋友们开心的笑声。",
    "pause_after_s": 0.72
  },
  {
    "id": "p006_u01",
    "paragraph_id": "p006",
    "text": "原来，那些好听的声音，根本不需要锁在木头盒子里，",
    "pause_after_s": 0.72
  },
  {
    "id": "p006_u02",
    "paragraph_id": "p006",
    "text": "它们早就变成了温暖的记忆，稳稳地住在自己的小脑袋和心里啦；",
    "pause_after_s": 0.72
  },
  {
    "id": "p006_u03",
    "paragraph_id": "p006",
    "text": "只要看见这片小叶子，随时都能想起来。",
    "pause_after_s": 0.72
  },
  {
    "id": "p006_u04",
    "paragraph_id": "p006",
    "text": "皮皮笑着把小木盒盖好，端端正正地放回书架上。",
    "pause_after_s": 0.72
  },
  {
    "id": "p006_u05",
    "paragraph_id": "p006",
    "text": "今晚，他不用再为了留住秋天的声音，把白天走过的每一段路重新走一遍了。",
    "pause_after_s": 0.72
  },
  {
    "id": "p007_u01",
    "paragraph_id": "p007",
    "text": "窗外的秋夜，也像合上了盖子的木盒一样，慢慢放轻了所有的声响。",
    "pause_after_s": 0.72
  },
  {
    "id": "p007_u02",
    "paragraph_id": "p007",
    "text": "皮皮钻进被窝，盖好暖黄色的毛毯，把胡萝卜玩偶抱在胸前。",
    "pause_after_s": 0.72
  },
  {
    "id": "p007_u03",
    "paragraph_id": "p007",
    "text": "书架上的小木盒歇着，他的小爪子和长耳朵也歇着。",
    "pause_after_s": 0.72
  },
  {
    "id": "p008_u01",
    "paragraph_id": "p008",
    "text": "皮皮闭上眼睛，嘴角轻轻弯着。",
    "pause_after_s": 0.72
  },
  {
    "id": "p008_u02",
    "paragraph_id": "p008",
    "text": "今天度过的好时光，已经永远不怕忘记了。",
    "pause_after_s": 0.72
  },
  {
    "id": "p008_u03",
    "paragraph_id": "p008",
    "text": "小朋友，把今天开心的回忆轻轻留在心里吧。",
    "pause_after_s": 0.72
  },
  {
    "id": "p008_u04",
    "paragraph_id": "p008",
    "text": "现在，不去想白天的热闹，静静听一听夜晚的安静，慢慢睡吧。",
    "pause_after_s": 0.72
  },
  {
    "id": "p008_u05",
    "paragraph_id": "p008",
    "text": "晚安。",
    "pause_after_s": 0.72
  }
]
